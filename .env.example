# Copy sang .env (da nam trong .gitignore) roi dien gia tri that. File nay chi chua placeholder.
# docker compose doc cac bien duoi day; de trong thi stack van chay, chi rieng Google SSO bi tat.

# --- Google SSO (tuy chon) ---
# Lay tu Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client ID.
# GOOGLE_REDIRECT_URI phai duoc khai bao y het trong muc "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/login/oauth2/code/google

# --- Entrypoint cong khai cua SPA (auth-service redirect ve day sau khi SSO thanh cong) ---
FRONTEND_URL=http://localhost:5173
