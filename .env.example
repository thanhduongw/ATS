# Chép thành .env ở gốc repo (cạnh docker-compose.yml), điền giá trị thật. KHÔNG commit file .env thật.
# Dùng chung cho máy local và VPS; chỉ khác phần "Địa chỉ truy cập".
# Ngoài file này còn 4 file bí mật của service: auth-service/.env, candidate-service/.env,
# notification-service/.env, ai-service/.env (mail, S3, khóa AI) — xem deploy/README.md.

# --- Địa chỉ truy cập ---
# Local:  DOMAIN=:80   PUBLIC_URL=http://localhost
# VPS chạy bằng IP:  DOMAIN=:80   PUBLIC_URL=http://<IP_VPS>
# VPS có tên miền (Caddy tự cấp HTTPS; DNS bản ghi A phải trỏ về IP VPS):  DOMAIN=ats.tenmien.vn   PUBLIC_URL=https://ats.tenmien.vn
DOMAIN=:80
PUBLIC_URL=http://localhost

# --- Mật khẩu hạ tầng: tạo bằng  openssl rand -hex 24  (chỉ dùng chữ và số, tránh @ : / trong URL) ---
# Postgres chỉ nhận mật khẩu này lúc tạo volume lần đầu; đổi sau đó thì phải ALTER USER (xem deploy/README.md).
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=
RABBITMQ_USER=ats_user
RABBITMQ_PASSWORD=

# --- Khóa ký JWT, dùng chung cho auth-service / api-gateway / notification-service ---
# Tạo bằng:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# --- Heap tối đa mỗi JVM. 384m cho máy 8 GB, 512m cho máy 16 GB ---
JAVA_MAX_HEAP=384m

# --- Google SSO (tùy chọn, để trống thì nút "Đăng nhập bằng Google" tự tắt) ---
# Redirect URI cần khai báo trong Google Cloud Console: <PUBLIC_URL>/api/auth/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- (Tùy chọn) tên project Docker. Bỏ trống thì lấy theo tên thư mục (ats -> volume ats_pgdata).
# Đặt tên khác khi muốn một bộ dữ liệu riêng trên cùng máy, ví dụ COMPOSE_PROJECT_NAME=ats-local.
# COMPOSE_PROJECT_NAME=
