# ============================================================
# AI Service — Environment Configuration
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ats_user:ats_password@localhost:5432/ats_ai

# --- RabbitMQ ---
RABBITMQ_URL=amqp://ats_user:ats_password@localhost:5672/

# --- MinIO / S3 ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ats-bucket

# --- LLM API Keys ---
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# --- Model Configuration ---
PRIMARY_LLM_MODEL=gpt-4o-mini
FALLBACK_LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct

# --- Service URLs (gọi Java backend) ---
RECRUITMENT_SERVICE_URL=http://localhost:8083
APPLICATION_SERVICE_URL=http://localhost:8089
CANDIDATE_SERVICE_URL=http://localhost:8084
MASTERDATA_SERVICE_URL=http://localhost:8082
