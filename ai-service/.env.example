# ============================================================
# AI Service — Environment Configuration
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ats_user:ats_password@localhost:5432/ats_ai

# --- RabbitMQ ---
RABBITMQ_URL=amqp://ats_user:ats_password@localhost:5672/

# --- AWS S3 (cùng bucket / khoá với candidate-service; ai-service chỉ cần quyền đọc) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=ats-bucket
AWS_S3_REGION=us-east-1

# --- LLM API Keys ---
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# --- Model Configuration ---
PRIMARY_LLM_MODEL=gemini-3.5-flash-lite
# Để trống = không dự phòng (lỗi -> FAILED, HR chấm lại)
FALLBACK_LLM_MODEL=
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct

# --- Service URLs (gọi Java backend) ---
RECRUITMENT_SERVICE_URL=http://localhost:8083
APPLICATION_SERVICE_URL=http://localhost:8089
CANDIDATE_SERVICE_URL=http://localhost:8084
MASTERDATA_SERVICE_URL=http://localhost:8082
