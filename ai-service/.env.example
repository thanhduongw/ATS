# ============================================================
# AI Service — Environment Configuration
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ats_user:ats_password@localhost:5432/ats_ai

# --- RabbitMQ ---
RABBITMQ_URL=amqp://ats_user:ats_password@localhost:5672/

# --- AWS S3 (cùng bucket / khoá với candidate-service; ai-service chỉ cần quyền đọc) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=ats-bucket
AWS_S3_REGION=us-east-1

# --- LLM API Keys ---
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# --- Model Configuration ---
PRIMARY_LLM_MODEL=gemini-3.5-flash-lite
# Để trống = không dự phòng (lỗi -> FAILED, HR chấm lại)
FALLBACK_LLM_MODEL=
EMBEDDING_MODEL=gemini-embedding-001
# Model nhẹ tách câu tìm kiếm Talent Pool thành bộ lọc (nhanh hơn model chấm điểm)
QUERY_PARSE_MODEL=gemini-3.1-flash-lite

# --- Chấm điểm: ngưỡng xếp loại (điểm 0-100 = trung bình các tiêu chí 1-5 x 20) ---
# Phù hợp nếu điểm >= SCORING_FIT_THRESHOLD; Chưa phân loại nếu SCORING_NOT_FIT_THRESHOLD <= điểm < SCORING_FIT_THRESHOLD;
# Không phù hợp nếu điểm < SCORING_NOT_FIT_THRESHOLD. Đủ điểm Phù hợp nhưng có tiêu chí = 1 thì hạ về Chưa phân loại.
SCORING_FIT_THRESHOLD=70
SCORING_NOT_FIT_THRESHOLD=60

# --- Service URLs (gọi Java backend) ---
RECRUITMENT_SERVICE_URL=http://localhost:8083
APPLICATION_SERVICE_URL=http://localhost:8089
MASTERDATA_SERVICE_URL=http://localhost:8082
