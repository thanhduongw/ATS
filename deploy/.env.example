# Chép thành ~/ats/.env trên VPS (cạnh docker-compose.prod.yml), điền giá trị thật, rồi: chmod 600 .env
# KHÔNG commit file .env thật.

# --- Image ---
REGISTRY=ghcr.io/thanhduongw/ats
TAG=latest

# --- Domain công khai (DNS bản ghi A phải trỏ về IP VPS trước khi chạy Caddy) ---
DOMAIN=ats.tenmien.vn
PUBLIC_URL=https://ats.tenmien.vn

# --- Mật khẩu hạ tầng: tạo bằng  openssl rand -hex 24  (chỉ dùng chữ và số, tránh @ : / trong URL) ---
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=
RABBITMQ_USER=ats_user
RABBITMQ_PASSWORD=

# --- Khóa ký JWT, dùng chung cho auth-service / api-gateway / notification-service ---
# Tạo bằng:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# --- Heap tối đa mỗi JVM. 384m cho VPS 8 GB, 512m cho VPS 16 GB ---
JAVA_MAX_HEAP=384m

# --- Google SSO (tùy chọn, để trống thì nút "Đăng nhập bằng Google" tự tắt) ---
# Redirect URI cần khai báo trong Google Cloud Console: <PUBLIC_URL>/api/auth/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
