# Copy file này thành .env rồi thay <IP-LAN-cua-may-dev> bằng IP thật của máy dev.
# Lấy IP: ipconfig | Select-String "IPv4"  → dùng IP của card Wi-Fi (cùng mạng với điện thoại).
# KHÔNG dùng localhost / 127.0.0.1: điện thoại sẽ trỏ về chính nó, không thấy backend.
EXPO_PUBLIC_API_BASE_URL=http://<IP-LAN-cua-may-dev>:8080/api

